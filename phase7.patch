diff --git a/Gameplay/MiniGames/dont_blink_game.gd b/Gameplay/MiniGames/dont_blink_game.gd
new file mode 100644
index 0000000..e6102f5
--- /dev/null
+++ b/Gameplay/MiniGames/dont_blink_game.gd
@@ -0,0 +1,193 @@
+class_name DontBlinkGame
+extends RefCounted
+## The rules of the "Don't Blink" mini-game. Plain logic: no nodes, no UI, no physics. The room (presentation)
+## feeds it the players' speeds every frame and shows what it decides, so the host can own an instance later.
+##
+## A giant eye watches the room. The light flashes at random:
+##   light ON  (the eye WATCHES)  everyone must stand completely still
+##   light OFF (the eye is shut)  everyone may move toward the exit
+## A player who moves while watched is detected: the danger level goes up for EVERYONE. At maximum danger every
+## player who has not reached the exit loses. A player who reaches the exit wins at that moment and is safe,
+## whatever the others do afterwards. Players may walk out of the room at any time (they just stop taking part).
+##
+## Flow: join() -> countdown -> running (starts dark) -> ended. Call tick() every frame while it is not IDLE.
+
+signal watching_changed(watching: bool)
+signal player_detected(player_id: int)
+signal danger_changed(level: int)
+signal player_won(player_id: int)
+signal player_lost(player_id: int)
+signal ended
+
+enum State { IDLE, COUNTDOWN, RUNNING, ENDED }
+
+## Danger level at which everybody still playing loses.
+var max_danger := 5
+## Speed (metres per second) above which a player counts as moving. Turning the camera is not moving.
+var still_speed := 0.15
+## Seconds after the light comes on before moving is punished, so players have time to stop.
+var reaction_grace := 0.5
+## Seconds between the first player joining and the first (dark) phase. Others may join meanwhile.
+var countdown_time := 3.0
+## Seconds before everybody still playing loses. 0 = no time limit.
+var time_limit := 0.0
+## (min, max) seconds the eye watches / the room is dark. Each phase picks a random value in range.
+var watch_time := Vector2(1.5, 3.0)
+var dark_time := Vector2(2.0, 4.5)
+## Every danger level makes the eye watch this much longer and the dark phases this much shorter.
+var watch_growth := 0.12
+var dark_shrink := 0.10
+var rng := RandomNumberGenerator.new()
+
+var state := State.IDLE
+var watching := false
+var danger := 0
+var elapsed := 0.0
+
+var _players := {}                       # player id -> "playing" | "won" | "lost" | "left"
+var _countdown := 0.0
+var _phase_left := 0.0
+var _watch_elapsed := 0.0
+var _caught := {}                        # players already detected in the current watching phase
+
+
+## A player steps up to take part. Only possible before the first dark phase starts.
+func join(player_id: int) -> bool:
+	if state != State.IDLE and state != State.COUNTDOWN:
+		return false
+	if status_of(player_id) == "playing":
+		return true
+	_players[player_id] = "playing"
+	if state == State.IDLE:
+		state = State.COUNTDOWN
+		_countdown = countdown_time
+	return true
+
+
+## The player stopped taking part (walked out of the room). No result, no penalty.
+func leave(player_id: int) -> void:
+	if status_of(player_id) != "playing":
+		return
+	_players[player_id] = "left"
+	_check_end()
+
+
+## The player reached the exit. Returns true when that counted as a win.
+func finish(player_id: int) -> bool:
+	if state != State.RUNNING or status_of(player_id) != "playing":
+		return false
+	_players[player_id] = "won"
+	player_won.emit(player_id)
+	_check_end()
+	return true
+
+
+## Advance by `delta` seconds. speeds: {player id: speed in m/s} for the players taking part.
+func tick(delta: float, speeds := {}) -> void:
+	if state == State.COUNTDOWN:
+		_countdown -= delta
+		if _countdown <= 0.0:
+			state = State.RUNNING
+			elapsed = 0.0
+			danger = 0
+			_set_watching(false)             # the first phase is dark
+		return
+	if state != State.RUNNING:
+		return
+	elapsed += delta
+	if time_limit > 0.0 and elapsed >= time_limit:
+		_lose_all()
+		return
+	if watching:
+		_watch_elapsed += delta
+		if _watch_elapsed >= reaction_grace:
+			for id in playing_ids():
+				if _caught.has(id) or float(speeds.get(id, 0.0)) <= still_speed:
+					continue
+				_caught[id] = true
+				danger += 1
+				player_detected.emit(id)
+				danger_changed.emit(danger)
+				if danger >= max_danger:
+					_lose_all()
+					return
+	_phase_left -= delta
+	if _phase_left <= 0.0:
+		_set_watching(not watching)
+
+
+func status_of(player_id: int) -> String:
+	return _players.get(player_id, "")
+
+
+func playing_ids() -> Array[int]:
+	var out: Array[int] = []
+	for id in _players:
+		if _players[id] == "playing":
+			out.append(id)
+	return out
+
+
+## Back to the start, ready for a new attempt.
+func reset() -> void:
+	state = State.IDLE
+	watching = false
+	danger = 0
+	elapsed = 0.0
+	_players.clear()
+	_caught.clear()
+	_countdown = 0.0
+	_phase_left = 0.0
+	_watch_elapsed = 0.0
+
+
+## Seconds left in the countdown (0 once running).
+func countdown_left() -> float:
+	return maxf(_countdown, 0.0) if state == State.COUNTDOWN else 0.0
+
+
+## Seconds left before the time limit, or -1 when there is none.
+func time_left() -> float:
+	return maxf(time_limit - elapsed, 0.0) if time_limit > 0.0 and state == State.RUNNING else -1.0
+
+
+## The (min, max) the next watching / dark phase is drawn from at the current danger level.
+func current_watch_range() -> Vector2:
+	return watch_time * (1.0 + watch_growth * danger)
+
+
+func current_dark_range() -> Vector2:
+	return dark_time * maxf(1.0 - dark_shrink * danger, 0.4)
+
+
+func _set_watching(value: bool) -> void:
+	watching = value
+	_caught.clear()
+	_watch_elapsed = 0.0
+	var r := current_watch_range() if value else current_dark_range()
+	_phase_left = rng.randf_range(r.x, r.y)
+	watching_changed.emit(value)
+
+
+func _lose_all() -> void:
+	for id in playing_ids():
+		_players[id] = "lost"
+		player_lost.emit(id)
+	state = State.ENDED
+	watching = false
+	ended.emit()
+
+
+## Nobody is still playing: the game is over (or, when everybody just walked away, simply reset).
+func _check_end() -> void:
+	if state != State.COUNTDOWN and state != State.RUNNING:
+		return
+	if not playing_ids().is_empty():
+		return
+	for id in _players:
+		if _players[id] == "won" or _players[id] == "lost":
+			state = State.ENDED
+			watching = false
+			ended.emit()
+			return
+	reset()
diff --git a/Gameplay/MiniGames/dont_blink_room.gd b/Gameplay/MiniGames/dont_blink_room.gd
new file mode 100644
index 0000000..a0dac6f
--- /dev/null
+++ b/Gameplay/MiniGames/dont_blink_room.gd
@@ -0,0 +1,313 @@
+class_name DontBlinkRoom
+extends Node3D
+## The "Don't Blink" mini-game inside one room: a giant eye in the ceiling, a START pad and an EXIT pad, and the
+## room lights that flash with the eye. The rules are in DontBlinkGame; this node only measures how fast the
+## players move, feeds the rules, and shows the outcome. Add it as a child of the building generator, then
+## call setup(). The host (SoloMatch for now) listens to the signals and hands out the reward.
+##
+## How a player plays it: step on the amber START pad (a short countdown begins, others may join), then cross the
+## room to the green EXIT pad. While the eye is open you must not move. A reward (a TRAP SCAN: a hint about one
+## nearby room) is given the moment a player reaches the EXIT pad.
+
+signal player_won(room_label: String, player_id: int)
+signal player_detected(room_label: String, player_id: int)
+## What the HUD should show for the local player: see MiniGamePanel. {} = nothing (hide it).
+signal hud_state_changed(state: Dictionary)
+
+const TITLE := "DON'T BLINK"
+const LOCAL_ID := 1                      # the player on this machine, until the network layer assigns ids
+const CEILING := 3.0                     # interior height above the floor
+const EYE_RADIUS := 1.8
+const EYE_SINK := 1.2                    # the eye's centre is this far into the ceiling (its lowest point stays above head height)
+const PAD_RADIUS := 1.2
+const BOUNDS_MARGIN := 0.3               # beyond the room walls by this much = the player left
+const DARK_LIGHT := 0.2                  # share of the room lights that stays on while the eye is shut
+const WATCH_LIGHT := 2.2                 # the room lights flash this bright while the eye is open
+const TELEPORT_DISTANCE := 2.0           # a jump this big in one frame is a teleport, not movement
+const RESULT_SECONDS := 3.0              # how long the result stays before the room can be played again
+const EVENT_SECONDS := 1.5               # how long "THE EYE SAW YOU" stays on the HUD
+
+var game := DontBlinkGame.new()
+var room_label := ""
+## Set when the reward was handed out: the room stays calm and cannot be played again.
+var claimed := false
+## (body) -> player id, or -1 when the body is not a player. Default: the local player group is id 1.
+var id_resolver := Callable()
+
+var _generator: Node3D
+var _half := 6.0
+var _bodies := {}                        # player id -> the body taking part
+var _last_pos := {}
+var _open := 0.0                         # 0 = eye shut, 1 = eye open
+var _light_mul := 1.0
+var _end_left := 0.0
+var _event_text := ""
+var _event_left := 0.0
+var _flash := false
+var _last_hud_key := ""
+
+var _eye_root: Node3D
+var _look: Node3D
+var _lid_pivot: Node3D
+var _iris_mat: StandardMaterial3D
+var _eye_light: OmniLight3D
+var _room_lights: Array[Dictionary] = []
+var _start_pad := {}
+var _finish_pad := {}
+
+
+## The node must already be in the tree (add_child first). rd: the RoomData of the room.
+func setup(generator: Node3D, rd, seed_value: int) -> void:
+	_generator = generator
+	room_label = rd.label
+	_half = float(generator.room_cells) * RoomGrid.CELL_SIZE.x * 0.5
+	game.rng.seed = seed_value
+	global_position = generator.get_room_floor_center(rd)
+	_build_eye()
+	var corner := _half - 2.4
+	_start_pad = _build_pad("START", Vector3(-corner, 0.0, -corner), UIStyle.AMBER, _on_start_entered)
+	_finish_pad = _build_pad("EXIT", Vector3(corner, 0.0, corner), Color(0.35, 0.9, 0.45), _on_finish_entered)
+	for n in generator.get_children():
+		if n is OmniLight3D:
+			var p: Vector3 = (n as Node3D).global_position - global_position
+			if absf(p.x) <= _half and absf(p.z) <= _half:
+				_room_lights.append({"light": n, "base": (n as OmniLight3D).light_energy})
+	game.player_detected.connect(_on_detected)
+	game.player_won.connect(func(id: int) -> void: player_won.emit(room_label, id))
+	game.ended.connect(func() -> void: _end_left = RESULT_SECONDS)
+
+
+## The reward was handed out: the eye sleeps for good.
+func mark_claimed() -> void:
+	claimed = true
+	game.reset()
+	_bodies.clear()
+	_last_pos.clear()
+	for pad in [_start_pad, _finish_pad]:
+		(pad["label"] as Label3D).text = "DONE"
+		(pad["label"] as Label3D).modulate = UIStyle.TEXT_MUTED
+		((pad["disc"] as MeshInstance3D).material_override as StandardMaterial3D).emission_energy_multiplier = 0.15
+
+
+func _physics_process(delta: float) -> void:
+	if _generator == null:
+		return
+	var speeds := {}
+	for id in _bodies.keys():
+		var body := _bodies[id] as Node3D
+		if not is_instance_valid(body):
+			_drop(id)
+			continue
+		var p := body.global_position
+		if absf(p.x - global_position.x) > _half + BOUNDS_MARGIN or absf(p.z - global_position.z) > _half + BOUNDS_MARGIN:
+			_drop(id)                                    # walked out of the room: no result, no penalty
+			continue
+		var moved := p.distance_to(_last_pos[id])
+		_last_pos[id] = p
+		speeds[id] = 0.0 if moved > TELEPORT_DISTANCE else moved / maxf(delta, 0.0001)
+	game.tick(delta, speeds)
+	if _end_left > 0.0:
+		_end_left -= delta
+		if _end_left <= 0.0:
+			game.reset()
+			_bodies.clear()
+			_last_pos.clear()
+	_event_left = maxf(_event_left - delta, 0.0)
+	_update_visuals(delta)
+	_emit_hud()
+
+
+func _drop(id: int) -> void:
+	_bodies.erase(id)
+	_last_pos.erase(id)
+	game.leave(id)
+
+
+func _id_of(body: Node3D) -> int:
+	if id_resolver.is_valid():
+		return int(id_resolver.call(body))
+	return LOCAL_ID if body.is_in_group("player") else -1
+
+
+func _on_start_entered(body: Node3D) -> void:
+	var id := _id_of(body)
+	if id < 0 or claimed or _end_left > 0.0:
+		return
+	if game.join(id):
+		_bodies[id] = body
+		_last_pos[id] = body.global_position
+
+
+func _on_finish_entered(body: Node3D) -> void:
+	var id := _id_of(body)
+	if id >= 0 and not claimed:
+		game.finish(id)
+
+
+func _on_detected(id: int) -> void:
+	player_detected.emit(room_label, id)
+	_event_text = "THE EYE SAW YOU" if id == LOCAL_ID else "THE EYE SAW SOMEONE"
+	_event_left = EVENT_SECONDS
+	if id == LOCAL_ID:
+		_flash = true
+
+
+# ---- what the HUD shows ------------------------------------------------------------------------------
+func _emit_hud() -> void:
+	var state := _hud_state()
+	var key := str(state)
+	if key == _last_hud_key and not state.get("flash", false):
+		return
+	_last_hud_key = key
+	hud_state_changed.emit(state)
+	_flash = false
+
+
+func _hud_state() -> Dictionary:
+	var status := game.status_of(LOCAL_ID)
+	if status == "" or status == "left":
+		return {}
+	var phase := "countdown"
+	if status == "won" or status == "lost":
+		phase = status
+	elif game.state == DontBlinkGame.State.RUNNING:
+		phase = "watching" if game.watching else "dark"
+	return {"title": TITLE, "phase": phase, "countdown": ceili(game.countdown_left()), "danger": game.danger,
+		"max_danger": game.max_danger, "time_left": snappedf(game.time_left(), 1.0),
+		"event": _event_text if _event_left > 0.0 else "", "flash": _flash}
+
+
+# ---- the eye, the pads, the lights ------------------------------------------------------------------
+func _build_eye() -> void:
+	_eye_root = Node3D.new()
+	_eye_root.name = "Eye"
+	_eye_root.position = Vector3(0.0, CEILING + EYE_SINK, 0.0)
+	add_child(_eye_root)
+
+	var ball := MeshInstance3D.new()
+	var ball_mesh := SphereMesh.new()
+	ball_mesh.radius = EYE_RADIUS
+	ball_mesh.height = EYE_RADIUS * 2.0
+	ball.mesh = ball_mesh
+	ball.material_override = _material(Color(0.93, 0.9, 0.84), Color(0.3, 0.28, 0.25), 0.25, 0.4)
+	_eye_root.add_child(ball)
+
+	_look = Node3D.new()                                 # turns toward the player; the iris is on its far side
+	_eye_root.add_child(_look)
+	_iris_mat = _material(Color(0.9, 0.55, 0.1), Color(1.0, 0.65, 0.12), 0.2, 0.3)
+	_look.add_child(_disc_mesh(EYE_RADIUS * 0.54, 0.3, Vector3(0.0, -EYE_RADIUS * 0.93, 0.0), _iris_mat))
+	_look.add_child(_disc_mesh(EYE_RADIUS * 0.235, 0.35, Vector3(0.0, -EYE_RADIUS * 1.04, 0.0), _material(Color(0.01, 0.01, 0.01), Color.BLACK, 0.0, 0.2)))
+
+	_lid_pivot = Node3D.new()                            # a hemisphere that swings over the eye: the eyelid
+	_eye_root.add_child(_lid_pivot)
+	var lid := MeshInstance3D.new()
+	var lid_mesh := SphereMesh.new()
+	lid_mesh.radius = EYE_RADIUS * 1.22                  # big enough to hide the iris, which bulges out of the eyeball
+	lid_mesh.height = EYE_RADIUS * 1.22
+	lid_mesh.is_hemisphere = true
+	lid.mesh = lid_mesh
+	lid.material_override = _material(Color(0.1, 0.06, 0.06), Color.BLACK, 0.0, 0.9)
+	_lid_pivot.add_child(lid)
+	_lid_pivot.rotation.x = PI                           # dome down = shut
+
+	_eye_light = OmniLight3D.new()
+	_eye_light.position = Vector3(0.0, -EYE_RADIUS - 0.3, 0.0)
+	_eye_light.omni_range = 18.0
+	_eye_light.light_energy = 0.0
+	_eye_root.add_child(_eye_light)
+
+
+func _disc_mesh(radius: float, flat: float, at: Vector3, mat: Material) -> MeshInstance3D:
+	var m := MeshInstance3D.new()
+	var s := SphereMesh.new()
+	s.radius = radius
+	s.height = radius * 2.0
+	m.mesh = s
+	m.scale = Vector3(1.0, flat, 1.0)
+	m.position = at
+	m.material_override = mat
+	return m
+
+
+func _material(albedo: Color, emission: Color, energy: float, rough: float) -> StandardMaterial3D:
+	var m := StandardMaterial3D.new()
+	m.albedo_color = albedo
+	m.roughness = rough
+	m.emission_enabled = energy > 0.0
+	m.emission = emission
+	m.emission_energy_multiplier = energy
+	return m
+
+
+func _build_pad(text: String, at: Vector3, color: Color, on_enter: Callable) -> Dictionary:
+	var root := Node3D.new()
+	root.position = at
+	add_child(root)
+	var cyl := CylinderMesh.new()
+	cyl.top_radius = PAD_RADIUS
+	cyl.bottom_radius = PAD_RADIUS
+	cyl.height = 0.04
+	var disc := MeshInstance3D.new()
+	disc.mesh = cyl
+	disc.position.y = 0.02
+	disc.material_override = _material(color * 0.4, color, 1.4, 0.6)
+	root.add_child(disc)
+	var label := Label3D.new()
+	label.text = text
+	label.billboard = BaseMaterial3D.BILLBOARD_ENABLED
+	label.font_size = 72
+	label.pixel_size = 0.0035
+	label.outline_size = 14
+	label.modulate = color
+	label.position.y = 1.5
+	root.add_child(label)
+	var area := Area3D.new()
+	area.collision_layer = 0
+	area.collision_mask = 1
+	area.monitorable = false
+	var shape := CollisionShape3D.new()
+	var cs := CylinderShape3D.new()
+	cs.radius = PAD_RADIUS
+	cs.height = 2.0
+	shape.shape = cs
+	shape.position.y = 1.0
+	area.add_child(shape)
+	root.add_child(area)
+	area.body_entered.connect(on_enter)
+	return {"root": root, "disc": disc, "label": label, "area": area}
+
+
+func _update_visuals(delta: float) -> void:
+	var running := game.state == DontBlinkGame.State.RUNNING
+	_open = move_toward(_open, 1.0 if (running and game.watching) else 0.0, delta * 8.0)
+	_lid_pivot.rotation.x = lerpf(PI, 0.0, _open)
+	var heat := float(game.danger) / float(maxi(game.max_danger, 1))
+	var colour := Color(1.0, 0.65, 0.12).lerp(Color(0.9, 0.08, 0.05), heat)
+	_iris_mat.albedo_color = colour * 0.55
+	_iris_mat.emission = colour
+	_iris_mat.emission_energy_multiplier = 0.2 + 1.3 * _open
+	_eye_light.light_energy = _open * (3.5 + 2.0 * heat)
+	_eye_light.light_color = Color(1.0, 0.95, 0.88).lerp(Color(1.0, 0.35, 0.25), heat)
+
+	var dir := Vector3.DOWN                              # the iris follows the player while the eye is open
+	var target := _look_target()
+	if target != null and _open > 0.05:
+		var want := (target.global_position + Vector3(0.0, 1.4, 0.0) - _eye_root.global_position).normalized()
+		var angle := Vector3.DOWN.angle_to(want)
+		dir = want if angle <= 0.9 else Vector3.DOWN.slerp(want, 0.9 / angle)
+	_look.basis = _look.basis.slerp(Basis(Quaternion(Vector3.DOWN, dir)), clampf(delta * 8.0, 0.0, 1.0))
+
+	var light_target := 1.0                              # the room lights follow the eye
+	if running:
+		light_target = WATCH_LIGHT if game.watching else DARK_LIGHT
+	_light_mul = move_toward(_light_mul, light_target, delta * 12.0)
+	for entry in _room_lights:
+		var l := entry["light"] as OmniLight3D
+		if is_instance_valid(l):
+			l.light_energy = float(entry["base"]) * _light_mul
+
+
+func _look_target() -> Node3D:
+	for id in _bodies:
+		return _bodies[id] as Node3D
+	return null
diff --git a/Gameplay/Rewards/hint_builder.gd b/Gameplay/Rewards/hint_builder.gd
new file mode 100644
index 0000000..bdb1ae9
--- /dev/null
+++ b/Gameplay/Rewards/hint_builder.gd
@@ -0,0 +1,159 @@
+class_name HintBuilder
+extends RefCounted
+## Builds the information the reward items give, from the building generator's room data.
+## Every function returns {"text": String, "true": bool, ...}. Hints are TRUE statements that name no room
+## and no exact amount, so they help without solving the level. With fake = true the same kind of statement
+## is built so that it is false: that is what a FALSE TIP sends to another player.
+
+const SIDE_NAMES := ["NORTHERN", "EASTERN", "SOUTHERN", "WESTERN"]       # N, E, S, W like RoomGrid.Dir
+
+
+## Rooms joined to c by a door (every neighbouring room that exists).
+static func neighbours(gen, c: Vector2i) -> Array[Vector2i]:
+	var out: Array[Vector2i] = []
+	for d in 4:
+		var n: Vector2i = c + RoomGrid.DIR_VECTORS[d]
+		if gen.rooms.has(n):
+			out.append(n)
+	return out
+
+
+## Distance in doors from origin to every reachable room.
+static func distances_from(gen, origin: Vector2i) -> Dictionary:
+	var dist := {origin: 0}
+	var queue: Array[Vector2i] = [origin]
+	while not queue.is_empty():
+		var c: Vector2i = queue.pop_front()
+		for n in neighbours(gen, c):
+			if not dist.has(n):
+				dist[n] = int(dist[c]) + 1
+				queue.append(n)
+	return dist
+
+
+## Doors between two rooms, or -1.
+static func door_distance(gen, a: Vector2i, b: Vector2i) -> int:
+	return int(distances_from(gen, a).get(b, -1))
+
+
+## Shortest way to the exit, starting with `from` itself. Empty when `from` is not a room.
+static func path_to_exit(gen, from: Vector2i) -> Array[Vector2i]:
+	var path: Array[Vector2i] = []
+	if not gen.rooms.has(from):
+		return path
+	var dist := distances_from(gen, gen.exit_room)
+	path.append(from)
+	var at := from
+	while at != gen.exit_room:
+		var best := at
+		for n in neighbours(gen, at):
+			if dist.has(n) and int(dist[n]) < int(dist[best]):
+				best = n
+		if best == at:
+			break
+		path.append(best)
+		at = best
+	return path
+
+
+## The neighbouring room that leads toward the exit: the default target of room-picking items.
+static func default_target_room(gen, from: Vector2i) -> Vector2i:
+	var path := path_to_exit(gen, from)
+	return path[1] if path.size() > 1 else from
+
+
+static func trap_scan(gen, room: Vector2i) -> Dictionary:
+	var rd = gen.rooms[room]
+	var trap: bool = rd.penalty != gen.PENALTY_NONE
+	return {"text": "ROOM %s: %s" % [rd.label, "TRAP DETECTED" if trap else "NO TRAP FOUND"], "true": true, "trap": trap}
+
+
+static func room_inspect(gen, room: Vector2i) -> Dictionary:
+	var rd = gen.rooms[room]
+	var what := "NO PENALTY"
+	if rd.penalty == gen.PENALTY_LOSE_POINTS:
+		what = "LOSES %d POINT%s" % [rd.amount, "" if rd.amount == 1 else "S"]
+	elif rd.penalty == gen.PENALTY_SKIP_ROUND:
+		what = "LOCKDOWN FOR %d ROUND%s" % [rd.amount, "" if rd.amount == 1 else "S"]
+	if rd.minigame:
+		what += " / OPTIONAL MINI-GAME"
+	return {"text": "ROOM %s: %s" % [rd.label, what], "true": true}
+
+
+## "One of the next three rooms toward the exit holds a penalty" (or, when none does, that they are clear).
+static func nearby_hint(gen, from: Vector2i, fake := false) -> Dictionary:
+	var path := path_to_exit(gen, from)
+	var ahead := path.slice(1, 4)
+	if ahead.is_empty():
+		return {"text": "THE EXIT IS RIGHT HERE", "true": true}
+	var any := false
+	for c in ahead:
+		if gen.rooms[c].penalty != gen.PENALTY_NONE:
+			any = true
+	var claim_penalty := any != fake                     # fake flips the statement
+	var text := "AT LEAST ONE OF THE NEXT %d ROOMS TOWARD THE EXIT HOLDS A PENALTY" % ahead.size() if claim_penalty \
+		else "THE NEXT %d ROOMS TOWARD THE EXIT ARE CLEAR" % ahead.size()
+	return {"text": text, "true": not fake}
+
+
+## "The eastern route has a dangerous room within two doors": the direction from here whose next two
+## rooms hold the most penalties. When nothing is dangerous nearby it says so.
+static func route_hint(gen, from: Vector2i, fake := false) -> Dictionary:
+	var danger := {}                                     # direction -> penalty rooms within two doors that way
+	for d in 4:
+		var n: Vector2i = from + RoomGrid.DIR_VECTORS[d]
+		if not gen.rooms.has(n):
+			continue
+		var count := int(gen.rooms[n].penalty != gen.PENALTY_NONE)
+		for m in neighbours(gen, n):
+			if m != from:
+				count += int(gen.rooms[m].penalty != gen.PENALTY_NONE)
+		danger[d] = count
+	if danger.is_empty():
+		return {"text": "NOTHING TO REPORT FROM HERE", "true": true}
+	var worst := -1
+	var safest := -1
+	for d in danger:
+		if worst < 0 or int(danger[d]) > int(danger[worst]):
+			worst = d
+		if int(danger[d]) == 0 and safest < 0:
+			safest = d
+	var anything: bool = int(danger[worst]) > 0
+	var claim_dir := -1                                  # -1 = claim that nothing is dangerous
+	if not fake and anything:
+		claim_dir = worst
+	elif fake and anything and safest >= 0:
+		claim_dir = safest                               # a quiet direction, called dangerous
+	elif fake and not anything:
+		claim_dir = int(danger.keys()[0])
+	var text := "NO DANGEROUS ROOM WITHIN TWO DOORS IN ANY DIRECTION" if claim_dir < 0 \
+		else "THE %s ROUTE HAS A DANGEROUS ROOM WITHIN TWO DOORS" % SIDE_NAMES[claim_dir]
+	return {"text": text, "true": not fake}
+
+
+## "The exit is closer to the northern side": the side of the building the exit room leans toward.
+static func exit_hint(gen, fake := false) -> Dictionary:
+	var centre := (int(gen.rooms_per_side) - 1) / 2.0
+	var off := Vector2(gen.exit_room.x - centre, gen.exit_room.y - centre)
+	if absf(off.x) < 0.5 and absf(off.y) < 0.5:
+		return {"text": "THE EXIT IS NEAR THE CENTRE OF THE BUILDING" if not fake else "THE EXIT IS CLOSER TO THE NORTHERN SIDE",
+			"true": not fake}
+	var side := 0
+	if absf(off.x) >= absf(off.y):
+		side = 1 if off.x > 0.0 else 3
+	else:
+		side = 2 if off.y > 0.0 else 0
+	if fake:
+		side = (side + 2) % 4                            # the opposite side
+	return {"text": "THE EXIT IS CLOSER TO THE %s SIDE" % SIDE_NAMES[side], "true": not fake}
+
+
+## A hint of a random kind for the room `from`; fake = false/true as above.
+static func random_tip(gen, from: Vector2i, rng: RandomNumberGenerator, fake: bool) -> Dictionary:
+	match rng.randi() % 3:
+		0:
+			return nearby_hint(gen, from, fake)
+		1:
+			return route_hint(gen, from, fake)
+		_:
+			return exit_hint(gen, fake)
diff --git a/Gameplay/Rewards/player_inventory.gd b/Gameplay/Rewards/player_inventory.gd
new file mode 100644
index 0000000..338671f
--- /dev/null
+++ b/Gameplay/Rewards/player_inventory.gd
@@ -0,0 +1,62 @@
+class_name PlayerInventory
+extends RefCounted
+## One player's reward items. Plain data and rules, no UI and no nodes, so the host can own it and a
+## network layer can later replicate snapshot(). Items are not stackable: one item per slot.
+
+signal changed
+
+var capacity := 4
+
+var _items: Array[Dictionary] = []       # {"uid": int, "kind": String}
+var _next_uid := 1
+
+
+func count() -> int:
+	return _items.size()
+
+
+func is_full() -> bool:
+	return _items.size() >= capacity
+
+
+## Adds an item. Returns its uid, or 0 when the kind is unknown or the inventory is full.
+func add(kind: String) -> int:
+	if not RewardCatalog.exists(kind) or is_full():
+		return 0
+	var uid := _next_uid
+	_next_uid += 1
+	_items.append({"uid": uid, "kind": kind})
+	changed.emit()
+	return uid
+
+
+func remove(uid: int) -> bool:
+	for i in _items.size():
+		if int(_items[i]["uid"]) == uid:
+			_items.remove_at(i)
+			changed.emit()
+			return true
+	return false
+
+
+## {} when there is no such item.
+func get_item(uid: int) -> Dictionary:
+	for item in _items:
+		if int(item["uid"]) == uid:
+			return item
+	return {}
+
+
+## uid of the item in a slot (0-based), or 0 when the slot is empty.
+func slot_uid(slot: int) -> int:
+	return int(_items[slot]["uid"]) if slot >= 0 and slot < _items.size() else 0
+
+
+## What the HUD shows: [{slot, uid, kind, name, category, text}], filled slots only.
+func snapshot() -> Array[Dictionary]:
+	var out: Array[Dictionary] = []
+	for i in _items.size():
+		var def := RewardCatalog.info(_items[i]["kind"])
+		out.append({"slot": i, "uid": _items[i]["uid"], "kind": _items[i]["kind"], "name": def["name"],
+			"category": def["category"], "text": def["text"]})
+	return out
diff --git a/Gameplay/Rewards/reward_catalog.gd b/Gameplay/Rewards/reward_catalog.gd
new file mode 100644
index 0000000..88fcb83
--- /dev/null
+++ b/Gameplay/Rewards/reward_catalog.gd
@@ -0,0 +1,91 @@
+class_name RewardCatalog
+extends RefCounted
+## Every reward item a mini-game can grant. Data only: what an item does lives in RewardManager.
+##
+## Three categories (see the design):
+##   INFORMATION  - hints about rooms, routes and the exit. Useful, but never the whole answer.
+##   PROTECTION   - armed by the player, consumed by the next matching room effect.
+##   MANIPULATION - affects what OTHER players see; needs a target player.
+
+enum Category { INFORMATION, PROTECTION, MANIPULATION }
+
+const TRAP_SCAN := "trap_scan"
+const ROOM_INSPECT := "room_inspect"
+const NEARBY_HINT := "nearby_hint"
+const ROUTE_HINT := "route_hint"
+const EXIT_HINT := "exit_hint"
+const PENALTY_SHIELD := "penalty_shield"
+const POINT_GUARD := "point_guard"
+const LOCKDOWN_BREAKER := "lockdown_breaker"
+const FALSE_TIP := "false_tip"
+const INFO_JAMMER := "info_jammer"
+
+## name: short label on the HUD slot. text: tooltip. needs_room: the player may pick a room within range.
+const ITEMS := {
+	TRAP_SCAN: {"name": "TRAP SCAN", "category": Category.INFORMATION, "needs_room": true,
+		"text": "Tells you whether one nearby room holds a trap."},
+	ROOM_INSPECT: {"name": "ROOM INSPECT", "category": Category.INFORMATION, "needs_room": true,
+		"text": "Shows the exact effect of one nearby room."},
+	NEARBY_HINT: {"name": "AHEAD HINT", "category": Category.INFORMATION, "needs_room": false,
+		"text": "Says whether a penalty waits among the next three rooms toward the exit."},
+	ROUTE_HINT: {"name": "ROUTE HINT", "category": Category.INFORMATION, "needs_room": false,
+		"text": "Names a direction that has a dangerous room within two doors."},
+	EXIT_HINT: {"name": "EXIT HINT", "category": Category.INFORMATION, "needs_room": false,
+		"text": "Tells you which side of the building the exit is closer to."},
+	PENALTY_SHIELD: {"name": "SHIELD", "category": Category.PROTECTION, "needs_room": false,
+		"text": "The next points penalty you take is reduced."},
+	POINT_GUARD: {"name": "POINT GUARD", "category": Category.PROTECTION, "needs_room": false,
+		"text": "The next points penalty you would take is blocked completely."},
+	LOCKDOWN_BREAKER: {"name": "LOCKDOWN BREAKER", "category": Category.PROTECTION, "needs_room": false,
+		"text": "The next lockdown does not apply to you."},
+	FALSE_TIP: {"name": "FALSE TIP", "category": Category.MANIPULATION, "needs_room": false,
+		"text": "Sends another player a believable hint that is wrong."},
+	INFO_JAMMER: {"name": "JAMMER", "category": Category.MANIPULATION, "needs_room": false,
+		"text": "Another player's next information item shows nothing."},
+}
+
+## Chance of each category by zone of the room that holds the mini-game: [information, protection, manipulation].
+## Near the start information is common; near the exit protection matters more.
+const CATEGORY_WEIGHTS := [
+	[0.60, 0.30, 0.10],     # near start
+	[0.40, 0.40, 0.20],     # middle
+	[0.25, 0.55, 0.20],     # near exit
+]
+
+
+static func exists(kind: String) -> bool:
+	return ITEMS.has(kind)
+
+
+static func info(kind: String) -> Dictionary:
+	return ITEMS.get(kind, {})
+
+
+static func kinds_in(category: int) -> Array[String]:
+	var out: Array[String] = []
+	for kind in ITEMS:
+		if int(ITEMS[kind]["category"]) == category:
+			out.append(kind)
+	return out
+
+
+## Picks a reward kind. The host owns the rng (seed it from the match seed, room and player so it is repeatable).
+## allow_manipulation = false when there is nobody else to target (solo play).
+static func roll(rng: RandomNumberGenerator, zone: int, allow_manipulation := true) -> String:
+	var weights: Array = (CATEGORY_WEIGHTS[clampi(zone, 0, 2)] as Array).duplicate()
+	if not allow_manipulation:
+		weights[Category.MANIPULATION] = 0.0
+	var total := 0.0
+	for w in weights:
+		total += float(w)
+	var pick := rng.randf() * total
+	var category := int(Category.INFORMATION)
+	for i in weights.size():
+		if float(weights[i]) <= 0.0:
+			continue
+		category = i
+		pick -= float(weights[i])
+		if pick < 0.0:
+			break
+	var kinds := kinds_in(category)
+	return kinds[rng.randi() % kinds.size()]
diff --git a/Gameplay/Rewards/reward_manager.gd b/Gameplay/Rewards/reward_manager.gd
new file mode 100644
index 0000000..3381837
--- /dev/null
+++ b/Gameplay/Rewards/reward_manager.gd
@@ -0,0 +1,260 @@
+class_name RewardManager
+extends RefCounted
+## The host's rules for mini-game rewards: who owns which items, what using an item does, which protections are
+## armed. It never touches the UI, nodes, points or the scene: it returns plain result Dictionaries, so the
+## authoritative host decides what to show and apply, and a network layer can later call the same methods.
+##
+## Player actions the host validates through this class:
+##   complete_minigame()  a mini-game ended; a win puts ONE reward item in the player's inventory
+##   use_item()           the player uses an item whenever and wherever they like (not tied to the room won in)
+##   discard() / transfer_item()
+## Events the host reports before it applies them:
+##   resolve_lose_points() / resolve_lockdown()   protections that were armed by the player
+##
+## Open design questions are switches, not assumptions: `tradable` and `reusable` default to false.
+
+signal item_granted(player_id: int, kind: String)
+signal item_used(player_id: int, kind: String, result: Dictionary)
+## A tip (possibly false) reached a player. The sender and the truth are only in tips_log.
+signal tip_received(player_id: int, text: String)
+signal protection_used(player_id: int, kind: String)
+
+const REASONS := {
+	"unknown_player": "NO SUCH PLAYER",
+	"no_such_item": "YOU DO NOT HAVE THAT ITEM",
+	"lost": "MINI-GAME LOST: NO REWARD",
+	"already_done": "YOU ALREADY CLAIMED THIS ROOM'S REWARD",
+	"inventory_full": "INVENTORY FULL: DISCARD AN ITEM FIRST",
+	"already_armed": "THAT PROTECTION IS ALREADY ARMED",
+	"out_of_range": "THAT ROOM IS TOO FAR AWAY",
+	"bad_target": "INVALID TARGET",
+	"no_context": "NOTHING TO READ HERE",
+	"not_tradable": "ITEMS CANNOT BE TRADED",
+	"target_full": "THEIR INVENTORY IS FULL",
+}
+
+## Inventory slots per player (applied to players added after the change).
+var slots := 4
+## Can players give items to each other? Undecided in the design: off until decided.
+var tradable := false
+## Is an item kept after use? Undecided in the design: off (items are used up) until decided.
+var reusable := false
+## Points a SHIELD takes off the next penalty.
+var shield_reduction := 1
+## How many doors away a room may be for TRAP SCAN / ROOM INSPECT.
+var scan_range := 2
+## Every tip sent with FALSE TIP, for the host: {"from", "to", "text", "true"}.
+var tips_log: Array[Dictionary] = []
+
+var _inventories := {}                   # player id -> PlayerInventory
+var _armed := {}                         # player id -> {kind: true}
+var _jammed := {}                        # player id -> true: the next information item shows nothing
+var _claimed := {}                       # "player|room label" -> true
+
+
+func add_player(player_id: int) -> void:
+	if _inventories.has(player_id):
+		return
+	var inv := PlayerInventory.new()
+	inv.capacity = slots
+	_inventories[player_id] = inv
+	_armed[player_id] = {}
+
+
+func has_player(player_id: int) -> bool:
+	return _inventories.has(player_id)
+
+
+func inventory_of(player_id: int) -> PlayerInventory:
+	return _inventories.get(player_id)
+
+
+func minigame_claimed(player_id: int, room_label: String) -> bool:
+	return _claimed.has(_claim_key(player_id, room_label))
+
+
+func is_armed(player_id: int, kind: String) -> bool:
+	return (_armed.get(player_id, {}) as Dictionary).has(kind)
+
+
+## Names of the protections the player has armed, for the HUD.
+func armed_names(player_id: int) -> Array[String]:
+	var out: Array[String] = []
+	for kind in (_armed.get(player_id, {}) as Dictionary):
+		out.append(str(RewardCatalog.info(kind)["name"]))
+	return out
+
+
+# ---- rewards -------------------------------------------------------------------------------------
+## A mini-game ended. Only a win gives something: one item, once per player and room. The item is random for the
+## room's zone unless the mini-game names its own reward (forced_kind, e.g. Don't Blink always gives TRAP SCAN).
+## A full inventory refuses the reward WITHOUT using the claim up, so the player can free a slot and try again.
+func complete_minigame(player_id: int, room_label: String, won: bool, zone: int,
+		rng: RandomNumberGenerator, allow_manipulation := true, forced_kind := "") -> Dictionary:
+	var inv: PlayerInventory = inventory_of(player_id)
+	if inv == null:
+		return _fail("unknown_player")
+	if minigame_claimed(player_id, room_label):
+		return _fail("already_done")
+	if not won:
+		return _fail("lost")
+	if inv.is_full():
+		return _fail("inventory_full")
+	var kind := forced_kind if RewardCatalog.exists(forced_kind) else RewardCatalog.roll(rng, zone, allow_manipulation)
+	var uid := inv.add(kind)
+	_claimed[_claim_key(player_id, room_label)] = true
+	item_granted.emit(player_id, kind)
+	var def := RewardCatalog.info(kind)
+	return {"ok": true, "reason": "", "kind": kind, "uid": uid, "title": def["name"], "text": "ADDED TO YOUR INVENTORY", "data": {}}
+
+
+# ---- using items ---------------------------------------------------------------------------------
+## Use an item. ctx (all keys optional unless the item needs them):
+##   "generator"      the building generator (room data)             needed by information items
+##   "room"           Vector2i, the room the player is in            default: the start room
+##   "target_room"    Vector2i, for TRAP SCAN / ROOM INSPECT         default: the next room toward the exit
+##   "target_player"  int, for manipulation items
+##   "player_rooms"   {player id: Vector2i}, where players are       used by FALSE TIP
+##   "rng"            RandomNumberGenerator                          used by FALSE TIP
+## Returns {ok, reason, kind, uid, title, text, data}. A failed use changes nothing and keeps the item.
+func use_item(player_id: int, uid: int, ctx := {}) -> Dictionary:
+	var inv: PlayerInventory = inventory_of(player_id)
+	if inv == null:
+		return _fail("unknown_player")
+	var item := inv.get_item(uid)
+	if item.is_empty():
+		return _fail("no_such_item")
+	var kind: String = item["kind"]
+	var def := RewardCatalog.info(kind)
+	var result := {"ok": true, "reason": "", "kind": kind, "uid": uid, "title": def["name"], "text": "", "data": {}}
+	var category := int(def["category"])
+
+	if category == RewardCatalog.Category.INFORMATION:
+		var gen = ctx.get("generator")
+		if gen == null:
+			return _fail("no_context", kind)
+		if _jammed.has(player_id):                       # a JAMMER hit this player: the item is wasted
+			_jammed.erase(player_id)
+			result["text"] = "SIGNAL JAMMED: NOTHING RECEIVED"
+			result["data"] = {"jammed": true}
+			return _finish(inv, player_id, uid, kind, result)
+		var from: Vector2i = ctx.get("room", gen.start_room)
+		var read := _read_information(gen, kind, from, ctx)
+		if read.has("error"):
+			return _fail(str(read["error"]), kind)
+		result["text"] = read["text"]
+		result["data"] = read
+		return _finish(inv, player_id, uid, kind, result)
+
+	if category == RewardCatalog.Category.PROTECTION:
+		if is_armed(player_id, kind):
+			return _fail("already_armed", kind)
+		_armed[player_id][kind] = true
+		result["text"] = "ARMED: WAITING FOR THE NEXT MATCHING EFFECT"
+		return _finish(inv, player_id, uid, kind, result)
+
+	# manipulation: needs another player
+	var target := int(ctx.get("target_player", -1))
+	if target == player_id or not has_player(target):
+		return _fail("bad_target", kind)
+	if kind == RewardCatalog.FALSE_TIP:
+		var gen = ctx.get("generator")
+		if gen == null:
+			return _fail("no_context", kind)
+		var rooms: Dictionary = ctx.get("player_rooms", {})
+		var at: Vector2i = rooms.get(target, gen.start_room)
+		var rng: RandomNumberGenerator = ctx.get("rng", RandomNumberGenerator.new())
+		var tip := HintBuilder.random_tip(gen, at, rng, true)
+		tips_log.append({"from": player_id, "to": target, "text": tip["text"], "true": tip["true"]})
+		tip_received.emit(target, tip["text"])
+		result["text"] = "TIP SENT"
+	else:                                                # INFO_JAMMER
+		_jammed[target] = true
+		result["text"] = "THEIR NEXT INFORMATION ITEM WILL SHOW NOTHING"
+	return _finish(inv, player_id, uid, kind, result)
+
+
+## Information items. Returns the hint Dictionary, or {"error": reason} when the target is not valid.
+func _read_information(gen, kind: String, from: Vector2i, ctx: Dictionary) -> Dictionary:
+	match kind:
+		RewardCatalog.NEARBY_HINT:
+			return HintBuilder.nearby_hint(gen, from)
+		RewardCatalog.ROUTE_HINT:
+			return HintBuilder.route_hint(gen, from)
+		RewardCatalog.EXIT_HINT:
+			return HintBuilder.exit_hint(gen)
+	var target: Vector2i = ctx.get("target_room", HintBuilder.default_target_room(gen, from))
+	if not gen.rooms.has(target):
+		return {"error": "bad_target"}
+	var dist := HintBuilder.door_distance(gen, from, target)
+	if dist < 0 or dist > scan_range:
+		return {"error": "out_of_range"}
+	return HintBuilder.trap_scan(gen, target) if kind == RewardCatalog.TRAP_SCAN else HintBuilder.room_inspect(gen, target)
+
+
+# ---- protections ---------------------------------------------------------------------------------
+## The host calls this when a room is about to take points from the player. Returns
+## {"amount": points to take after protection, "blocked": bool, "by": item kind or ""}.
+## A POINT GUARD blocks the whole penalty; otherwise a SHIELD takes `shield_reduction` off.
+func resolve_lose_points(player_id: int, amount: int) -> Dictionary:
+	if _consume_armed(player_id, RewardCatalog.POINT_GUARD):
+		return {"amount": 0, "blocked": true, "by": RewardCatalog.POINT_GUARD}
+	if _consume_armed(player_id, RewardCatalog.PENALTY_SHIELD):
+		var left := maxi(amount - shield_reduction, 0)
+		return {"amount": left, "blocked": left == 0, "by": RewardCatalog.PENALTY_SHIELD}
+	return {"amount": amount, "blocked": false, "by": ""}
+
+
+## The host calls this when a lockdown is about to hit the player. True = a LOCKDOWN BREAKER absorbed it.
+func resolve_lockdown(player_id: int) -> bool:
+	return _consume_armed(player_id, RewardCatalog.LOCKDOWN_BREAKER)
+
+
+# ---- inventory management ------------------------------------------------------------------------
+func discard(player_id: int, uid: int) -> bool:
+	var inv: PlayerInventory = inventory_of(player_id)
+	return inv != null and inv.remove(uid)
+
+
+## Give an item to another player. Refused while `tradable` is off.
+func transfer_item(from_id: int, uid: int, to_id: int) -> Dictionary:
+	var from_inv: PlayerInventory = inventory_of(from_id)
+	var to_inv: PlayerInventory = inventory_of(to_id)
+	if from_inv == null or to_inv == null or from_id == to_id:
+		return _fail("bad_target")
+	if not tradable:
+		return _fail("not_tradable")
+	var item := from_inv.get_item(uid)
+	if item.is_empty():
+		return _fail("no_such_item")
+	if to_inv.is_full():
+		return _fail("target_full")
+	var kind: String = item["kind"]
+	from_inv.remove(uid)
+	to_inv.add(kind)
+	return {"ok": true, "reason": "", "kind": kind, "uid": uid, "title": RewardCatalog.info(kind)["name"], "text": "ITEM GIVEN", "data": {}}
+
+
+# ---- internals -----------------------------------------------------------------------------------
+func _finish(inv: PlayerInventory, player_id: int, uid: int, kind: String, result: Dictionary) -> Dictionary:
+	if not reusable:
+		inv.remove(uid)
+	item_used.emit(player_id, kind, result)
+	return result
+
+
+func _consume_armed(player_id: int, kind: String) -> bool:
+	var armed: Dictionary = _armed.get(player_id, {})
+	if not armed.has(kind):
+		return false
+	armed.erase(kind)
+	protection_used.emit(player_id, kind)
+	return true
+
+
+func _claim_key(player_id: int, room_label: String) -> String:
+	return "%d|%s" % [player_id, room_label]
+
+
+func _fail(reason: String, kind := "") -> Dictionary:
+	return {"ok": false, "reason": reason, "kind": kind, "uid": 0, "title": "", "text": REASONS.get(reason, reason), "data": {}}
