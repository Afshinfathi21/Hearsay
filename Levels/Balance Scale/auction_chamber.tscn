show_player_list = false
show_local_panel = true
allow_transfers = false
starting_points = 100

[node name="Seating" type="Node" parent="." node_paths=PackedStringArray("hud", "seats_root")]
script = ExtResource("seating_script")
hud = NodePath("../UI/GameHUD")
seats_root = NodePath("../Seats")

[node name="Presenter" type="Node" parent="." node_paths=PackedStringArray("seating", "hud", "seats_root", "pots_root", "table", "round_display", "lights_root")]
script = ExtResource("presenter_script")
seating = NodePath("../Seating")
hud = NodePath("../UI/GameHUD")
seats_root = NodePath("../Seats")
pots_root = NodePath("../AcidPots")
table = NodePath("../AuctionTable")
round_display = NodePath("../RoundDisplay")
lights_root = NodePath("../Lighting")
