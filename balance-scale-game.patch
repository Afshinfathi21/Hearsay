+		_pots[seat].set_danger(level)
+	if _glows[seat] != null:
+		var colors := [Color(0.6, 1.0, 0.3), Color(0.95, 0.85, 0.2), Color(1.0, 0.5, 0.12), Color(1.0, 0.16, 0.1)]
