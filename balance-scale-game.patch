+		var tween := create_tween().set_parallel(true)
+		tween.tween_property(glow, "light_color", colors[mini(level, 3)], 0.8)
+		tween.tween_property(glow, "light_energy", [0.9, 1.3, 1.8, 2.6][mini(level, 3)], 0.8)
