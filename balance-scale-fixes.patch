+	pot.released.connect(func() -> void: seen["released"] = true)
 	pot.release()
 	await create_timer(1.1).timeout
-	_check(released_seen, "release animation completes and emits its signal")
+	_check(seen["released"], "release animation completes and emits its signal")
 	_check(is_equal_approx(pot.fill, 0.0), "release drains the pot")
 
 	pot.reset()
