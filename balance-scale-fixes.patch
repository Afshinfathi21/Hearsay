 		_finish()
 		return
 
+	var latch_rest := pot.latch.position.x
 	pot.fill = 0.5
 	_check(is_equal_approx(pot.fill, 0.5) and is_equal_approx(pot.liquid.scale.y, 0.5), "manual fill updates the liquid mesh")
 
